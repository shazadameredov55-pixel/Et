import asyncio
import csv
import hashlib
import re
import sqlite3
from datetime import datetime, timezone
from urllib.parse import urljoin

from playwright.async_api import async_playwright


DB = "etsy.db"
OUTPUT = "etsy_products.csv"

# Başlangıç keşfi.
# Program sonuç sayfalarından yeni ürünleri buldukça devam eder.
START_URL = "https://www.etsy.com/search?q=handmade"

# Aynı sayfayı tekrar tekrar taramamak için.
MAX_EMPTY_PAGES = 3

# İstekleri gereksiz yere hızlandırmamak için.
PAGE_DELAY = 3


def now():
    return datetime.now(timezone.utc).isoformat()


def init_db():
    db = sqlite3.connect(DB)

    db.execute("""
        CREATE TABLE IF NOT EXISTS products (
            product_id TEXT PRIMARY KEY,
            title TEXT,
            price TEXT,
            currency TEXT,
            shop TEXT,
            rating TEXT,
            review_count TEXT,
            favorites TEXT,
            category TEXT,
            tags TEXT,
            url TEXT UNIQUE,
            first_seen TEXT
        )
    """)

    db.execute("""
        CREATE TABLE IF NOT EXISTS pages (
            url TEXT PRIMARY KEY,
            scanned_at TEXT
        )
    """)

    db.commit()
    return db


def product_id_from_url(url):
    # Etsy URL'lerindeki listing ID'yi yakalamaya çalış.
    m = re.search(r"/listing/(\d+)", url)

    if m:
        return m.group(1)

    # ID bulunamazsa URL'den deterministik ID üret.
    return hashlib.sha256(url.encode()).hexdigest()[:32]


def already_exists(db, product_id):
    row = db.execute(
        "SELECT 1 FROM products WHERE product_id = ?",
        (product_id,)
    ).fetchone()

    return row is not None


def save_product(db, p):
    if already_exists(db, p["product_id"]):
        return False

    db.execute("""
        INSERT INTO products (
            product_id,
            title,
            price,
            currency,
            shop,
            rating,
            review_count,
            favorites,
            category,
            tags,
            url,
            first_seen
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (
        p["product_id"],
        p["title"],
        p["price"],
        p["currency"],
        p["shop"],
        p["rating"],
        p["review_count"],
        p["favorites"],
        p["category"],
        p["tags"],
        p["url"],
        now()
    ))

    db.commit()
    return True


async def text_or_empty(locator):
    try:
        return (await locator.first.text_content() or "").strip()
    except Exception:
        return ""


async def scrape_product(page, url):
    try:
        await page.goto(
            url,
            wait_until="domcontentloaded",
            timeout=30000
        )

        await page.wait_for_timeout(1500)

        title = await text_or_empty(
            page.locator("h1")
        )

        shop = ""

        shop_selectors = [
            '[data-shop-name]',
            'a[href*="/shop/"]'
        ]

        for selector in shop_selectors:
            value = await text_or_empty(page.locator(selector))
            if value:
                shop = value
                break

        # Genel görünür metinden bilgi çıkarmaya çalış.
        body = await page.locator("body").inner_text()

        rating = ""
        review_count = ""
        favorites = ""

        rating_match = re.search(
            r"([0-5](?:\.\d+)?)\s*(?:out of 5|stars?)",
            body,
            re.I
        )

        if rating_match:
            rating = rating_match.group(1)

        review_match = re.search(
            r"([\d,]+)\s*(?:reviews?|ratings?)",
            body,
            re.I
        )

        if review_match:
            review_count = review_match.group(1)

        favorite_match = re.search(
            r"([\d,]+)\s*(?:favorites?|favorited)",
            body,
            re.I
        )

        if favorite_match:
            favorites = favorite_match.group(1)

        price = ""

        price_selectors = [
            '[data-buy-box-region] p',
            '[data-selector="price"]',
            'p[class*="price"]'
        ]

        for selector in price_selectors:
            value = await text_or_empty(page.locator(selector))
            if value:
                price = value
                break

        # JSON-LD'den kategori/ürün bilgisi yakalamaya çalış.
        category = ""
        tags = ""

        jsonlds = await page.locator(
            'script[type="application/ld+json"]'
        ).all_text_contents()

        for raw in jsonlds:
            if "category" in raw.lower():
                m = re.search(
                    r'"category"\s*:\s*"([^"]+)"',
                    raw,
                    re.I
                )
                if m:
                    category = m.group(1)
                    break

        return {
            "product_id": product_id_from_url(url),
            "title": title,
            "price": price,
            "currency": "",
            "shop": shop,
            "rating": rating,
            "review_count": review_count,
            "favorites": favorites,
            "category": category,
            "tags": tags,
            "url": url
        }

    except Exception as e:
        print(f"[!] Ürün okunamadı: {url}")
        print(f"    {e}")
        return None


async def discover_products(page):
    links = await page.locator(
        'a[href*="/listing/"]'
    ).evaluate_all("""
        els => els.map(a => a.href)
    """)

    clean = []

    for url in links:
        if not url:
            continue

        url = url.split("?")[0]

        if "/listing/" not in url:
            continue

        if url not in clean:
            clean.append(url)

    return clean


async def export_csv(db):
    rows = db.execute("""
        SELECT
            product_id,
            title,
            price,
            currency,
            shop,
            rating,
            review_count,
            favorites,
            category,
            tags,
            url,
            first_seen
        FROM products
        ORDER BY first_seen
    """).fetchall()

    columns = [
        "product_id",
        "title",
        "price",
        "currency",
        "shop",
        "rating",
        "review_count",
        "favorites",
        "category",
        "tags",
        "url",
        "first_seen"
    ]

    with open(
        OUTPUT,
        "w",
        newline="",
        encoding="utf-8"
    ) as f:
        writer = csv.writer(f)
        writer.writerow(columns)
        writer.writerows(rows)

    print(f"\n[+] CSV oluşturuldu: {OUTPUT}")
    print(f"[+] Toplam kayıt: {len(rows)}")


async def main():
    db = init_db()

    async with async_playwright() as pw:
        browser = await pw.chromium.launch(
            headless=False
        )

        context = await browser.new_context(
            viewport={"width": 1366, "height": 768}
        )

        search_page = await context.new_page()
        product_page = await context.new_page()

        current_url = START_URL
        page_number = 1
        empty_pages = 0

        try:
            while True:
                print(
                    f"\n[*] Sonuç sayfası {page_number}: "
                    f"{current_url}"
                )

                await search_page.goto(
                    current_url,
                    wait_until="domcontentloaded",
                    timeout=30000
                )

                await search_page.wait_for_timeout(
                    PAGE_DELAY * 1000
                )

                links = await discover_products(search_page)

                if not links:
                    empty_pages += 1
                    print("[!] Ürün bulunamadı.")

                    if empty_pages >= MAX_EMPTY_PAGES:
                        print(
                            "[!] Arka arkaya boş sayfalar."
                        )
                        break
                else:
                    empty_pages = 0

                print(f"[+] Bulunan ürün linki: {len(links)}")

                new_count = 0

                for index, url in enumerate(links, 1):
                    pid = product_id_from_url(url)

                    if already_exists(db, pid):
                        print(
                            f"[=] Daha önce var: "
                            f"{index}/{len(links)}"
                        )
                        continue

                    print(
                        f"[+] Yeni ürün: "
                        f"{index}/{len(links)}"
                    )

                    product = await scrape_product(
                        product_page,
                        url
                    )

                    if product and save_product(db, product):
                        new_count += 1

                    await asyncio.sleep(PAGE_DELAY)

                print(
                    f"[+] Bu sayfadaki yeni ürün: "
                    f"{new_count}"
                )

                # Sonraki sonuç sayfası.
                next_link = await search_page.locator(
                    'a[aria-label*="Next"], '
                    'a[href*="page="]'
                ).evaluate_all("""
                    els => {
                        for (const e of els) {
                            const txt =
                                (e.innerText || "").toLowerCase();

                            const aria =
                                (e.getAttribute("aria-label") || "")
                                .toLowerCase();

                            if (
                                txt.includes("next") ||
                                aria.includes("next")
                            ) {
                                return e.href;
                            }
                        }

                        return null;
                    }
                """)

                if not next_link:
                    # Genel arama sayfalamasını dene.
                    page_number += 1
                    separator = "&" if "?" in START_URL else "?"
                    current_url = (
                        f"{START_URL}"
                        f"{separator}page={page_number}"
                    )
                else:
                    current_url = next_link
                    page_number += 1

                db.execute(
                    "INSERT OR REPLACE INTO pages VALUES (?, ?)",
                    (current_url, now())
                )
                db.commit()

        except KeyboardInterrupt:
            print("\n[*] Kullanıcı tarafından durduruldu.")

        finally:
            await export_csv(db)
            await browser.close()
            db.close()


if __name__ == "__main__":
    asyncio.run(main())
